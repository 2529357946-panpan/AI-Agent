# true：无需 API Key，使用明确标记的离线演示结果
# false：调用 DeepSeek OpenAI 兼容接口
USE_FAKE_MODEL=true

# 切换到真实模型时填写。不要将真实 Key 提交到版本库。
DEEPSEEK_API_KEY=
MODEL_NAME=deepseek-chat
BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# 音频转写：默认使用明确标记的离线适配器。真实模式使用 OpenAI-compatible /audio/transcriptions。
USE_FAKE_TRANSCRIPTION=true
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=
STT_TIMEOUT_SECONDS=60
MAX_AUDIO_BYTES=26214400

# 历史知识 RAG。关闭后 /api/knowledge/query 返回 503，但会议主链不受影响。
RAG_ENABLED=true
RAG_TOP_K=5
RRF_K=60

# Ollama 负责本地输入检查、HyDE 和 embedding；不配置时使用确定性 Fake 实现。
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=

# Supabase 仅作为 pgvector + 模型结果缓存 sidecar，不是业务主数据库。
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_KEY=
CACHE_TTL_SECONDS=86400

# 可选；默认会在项目根目录创建 office_agent.db
# DATABASE_URL=sqlite:///./office_agent.db
# PostgreSQL 示例（需先创建数据库）：
# DATABASE_URL=postgresql+psycopg://office_agent:password@127.0.0.1:5432/office_agent
